extends "res://tests/test_park.gd"

func run() -> void:
	for size in [Vector2i(1280, 720), Vector2i(640, 360)]:
		root.size = size
		var park: Node = load("res://scenes/park.tscn").instantiate()
		root.add_child(park)
		await layout()
		var original := JSON.stringify(Dump.encode(park.items[1].sheet), "", true, true)
		var ids: Array = park.items.keys()
		# Take directly from startup: no validator, editor, fixture or preset normalization first.
		await tap(KEY_I)
		check(not park.inventory.visible, "Previous inventory key no longer toggles the inventory")
		await tap(KEY_TAB)
		check(park.inventory.visible and park.selected_id == 1 and not park.take_button.disabled, "Initial inventory offers own blank paper")
		key(KEY_TAB, true, true)
		await process_frame
		key(KEY_TAB, false)
		check(park.inventory.visible, "Held Tab repeat does not close inventory")
		park.inventory_list.grab_focus()
		await tap(KEY_TAB)
		check(not park.inventory.visible, "Tab closes inventory even when its list has keyboard focus")
		await tap(KEY_TAB)
		park.take_button.pressed.emit()
		for frame in 12: await process_frame
		check(park.held_id == 1 and park.items[1].state == "hand", "Initial take transfers original ID to hand")
		check(park.items[1].sheet.history.is_typed() and park.items[1].sheet.history.get_typed_builtin() == TYPE_DICTIONARY, "Initial empty history is typed from creation")
		check(park.carried_id == 1 and park.carried.mesh != null and park.carried.visible, "Initial blank paper renders for multiple frames")
		check(park.character.holding, "Character holds initial paper")
		check(JSON.stringify(Dump.encode(park.items[1].sheet), "", true, true) == original, "Taking does not modify blank paper data")
		invariant(park)
		await capture("initial_take_" + str(size.x))
		await tap(KEY_TAB)
		park.inspect_button.pressed.emit()
		await layout()
		check(park.inspection != null and park.inspection.model.mesh != null and not park.inspection.can_deploy, "Initial blank sheet has a real inspection without invented wing folds")
		await tap(KEY_ESCAPE)
		check(park.inspection == null and park.held_id == 1 and park.items[1].state == "hand", "Inspection returns same initial hand item")
		await tap(KEY_TAB)
		await tap(KEY_SPACE)
		await layout()
		check(park.active_flight != null and park.active_flight.body != null and park.active_flight.item_id == 1, "Blank sheet supports throw preparation without history type errors")
		await tap(KEY_B)
		await layout()
		check(park.active_flight == null and park.held_id == 1 and park.carried.visible, "Preparation cancellation restores original held paper")
		park.player.position = park.BENCH
		park.open_editor(1)
		await layout()
		check(park.editor != null and park.editor.history.is_empty() and park.editor.fold_count == 0, "Workbench opens unmodified initial blank paper")
		park.finish_edit(false)
		await layout()
		check(park.editor == null and park.items[1].state == "hand" and park.held_id == 1, "Workbench cancel preserves hand ownership")
		park.open_editor(1)
		await layout()
		park.finish_edit(true)
		await layout()
		check(park.editor == null and park.items[1].state == "stored" and park.held_id == -1, "Workbench can store the same still-unfolded paper")
		await tap(KEY_TAB)
		park.take_button.pressed.emit()
		await layout()
		check(park.held_id == 1 and park.carried_id == 1 and park.carried.mesh != null, "Stored blank sheet can be taken again")
		check(park.items.keys() == ids and JSON.stringify(Dump.encode(park.items[1].sheet), "", true, true) == original, "All transitions preserve original shape, stock, history, IDs and item count")
		invariant(park)
		park.queue_free()
		await layout()
	print("PAP initial take: %d checks, %d failures" % [checks, failures])
	quit(1 if failures else 0)
